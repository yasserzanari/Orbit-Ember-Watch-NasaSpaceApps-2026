# Request a free MAP_KEY from NASA FIRMS and set it on the server only.
# Copy this file to .env locally; never use a VITE_ prefix for this secret.
FIRMS_MAP_KEY=

# Only enable the CWFIS historical context after reviewing its End-User Agreement.
CWFIS_EULA_CONFIRMED=false

# Optional. The application server defaults to port 4174.
# PORT=4174
